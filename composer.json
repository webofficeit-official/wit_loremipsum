{
    "name": "woit/wit-loremipsum",
    "type": "typo3-cms-extension",
    "description": "Toolbar button for the TYPO3 CKEditor that inserts dummy text: Lorem Ipsum or German Blindtext, as sentence, paragraphs, list or heading.",
    "keywords": [
        "TYPO3",
        "extension",
        "CKEditor",
        "dummy text",
        "lorem ipsum",
        "blindtext",
        "WIT",
        "woit"
    ],
    "homepage": "https://extensions.typo3.org/extension/wit_loremipsum",
    "authors": [
        {
            "name": "Team WebofficeIT, Rahul R S",
            "email": "info@webofficeit.com",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/webofficeit-official/wit_loremipsum"
    },
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0",
        "typo3/cms-rte-ckeditor": "^14.0"
    },
    "autoload": {
        "psr-4": {
            "Woit\\WitLoremipsum\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "wit_loremipsum"
        }
    }
}
